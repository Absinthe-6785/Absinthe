{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:editor": "tsc --noEmit -p tsconfig.editor.json",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:undefined": "node scripts/typecheck-bare-identifiers.mjs",
    "lint:hardcoded-toasts": "node scripts/lint-hardcoded-toasts.mjs",
    "typecheck": "npm run typecheck:editor && npm run typecheck:undefined && npm run typecheck:app"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "@tanstack/react-virtual": "^3.14.2",
    "jszip": "^3.10.1",
    "katex": "^0.16.9",
    "lucide-react": "^0.400.0",
    "luxon": "^3.7.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.4.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/luxon": "^3.7.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^20.10.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.8"
  }
}
